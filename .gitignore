# Everything generated - builds, bundles, icons, test output, coverage.
# Kept in one directory so this file does not have to track each of them.
build/

node_modules/

# Generated source: written by scripts/generate-build-info.js at build time.
# It lives in src/ because the app imports it as a module.
src/shared/build-info.ts

# Local runner state and downloaded runner binaries
.localmost/
bundled-runner/

# Local environment and tooling
.env
.env.local
.envrc
.claude/
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
