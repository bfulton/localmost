version: 1

shared:
  network:
    allow:
      - "*.github.com"
      - "github.com"
      - "registry.npmjs.org"
      - "nodejs.org"
  filesystem:
    read:
      - "/etc"
      - "/var"
      - "/tmp"
      - "/bin"
      - "/sbin"
      - "/usr/bin"
      - "/usr/lib"
      - "/usr/libexec"
      - "/usr/sbin"
      - "/usr/share"
      - "/System"
      - "/Library/Developer"
      - "/Library/Preferences"
      - "/private/etc"
      - "/private/var/db"
      - "/private/var/select"
      - "/Applications/Xcode.app"
