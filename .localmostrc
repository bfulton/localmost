version: 1
level: strict

shared:
  # Container work goes through a filtering socket localmost owns and checks
  # against this allowlist; anything not named here is refused. CI's docker
  # jobs and the docker e2e pull alpine:3 from Docker Hub and mount the
  # workspace read-only. See docs/superpowers/specs/2026-09-05-docker-isolation-design.md.
  docker:
    pull:
      registries: [docker.io]
    run:
      images: ["alpine:3"]
      mounts:
        - path: ./
          mode: ro
      network: bridge
      # The docker e2e creates one network per run, joins a container to it and
      # removes it, so the network path has real-CLI coverage rather than unit
      # tests alone - twice now a body the tests accepted was refused on the
      # wire. Internal: these carry no traffic off the machine.
      networks:
        - name: "localmost-e2e-*"
          internal: true

  network:
    allow:
      - "*.github.com"
      - "github.com"
      - "registry.npmjs.org"
      - "nodejs.org"
  filesystem:
    # A job's macOS VM supplies its own OS and toolchains. The npm cache is
    # declared for when VM shares exist; until then a job is told it runs
    # without it.
    write:
      - "~/.npm"
    read:
      - "~/.npm"
