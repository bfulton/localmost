<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The app, its main, GPU and renderer helpers and Squirrel's ShipIt are
    signed with the hardened runtime and only this: V8 needs to map JIT
    code. No device or personal information access - the app records,
    locates and prints nothing. Never the App Sandbox: the app runs each
    job under sandbox-exec, which a sandboxed process cannot.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
